rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with your staff email(s)
    function staff() { return request.auth != null && request.auth.token.email in ['permanowbegenc992@gmail.com']; }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['status','createdAt','totalPrice','customer','items'])
        && d.status == 'pending' && d.createdAt == request.time
        && d.totalPrice is number && d.totalPrice > 0 && d.totalPrice < 100000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.customer.keys().hasOnly(['name','phone','address','note'])
        && d.customer.name is string && d.customer.name.size() <= 80
        && d.customer.phone.matches('^\\+993[67][0-9]{7}$')
        && d.customer.address is string && d.customer.address.size() <= 300
        && d.customer.note is string && d.customer.note.size() <= 300;
    }

    match /products/{id} { allow read: if true; allow write: if staff(); }
    match /orders/{id} {
      allow create: if validOrder();
      allow read, update, delete: if staff();
    }
  }
}
